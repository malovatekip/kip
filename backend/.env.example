# ── KIP Environment Variables ──
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Security — change this to a long random string in production
SECRET_KEY=kip-development-secret-key-change-me-before-deploy

# Database — SQLite for development (no setup needed)
DATABASE_URL=sqlite:///./kip.db

# Anthropic API — get yours at https://console.anthropic.com
# Sprint 1: Leave as placeholder. Sprint 2: Add your real key.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Environment
ENVIRONMENT=development

# Frontend URL — used to build links inside emails (e.g. email verification)
FRONTEND_URL=http://localhost:3000

# ── Email (verification emails) ──
# Sent via Gmail SMTP — no domain required, just your Gmail account.
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use your Gmail address as SMTP_USER/FROM_EMAIL, the 16-char App Password as SMTP_PASSWORD.
# Leave these blank in development — verification emails will just be logged to the console.
# Free tier limit: ~500 emails/day.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-char-app-password
FROM_EMAIL=your-gmail-address@gmail.com
FROM_NAME=KIP - Kwacha Intelligence Platform